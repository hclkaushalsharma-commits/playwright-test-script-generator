{
  "name": "playwright-test-script-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic Playwright test script generator for Sauce Labs Swag Labs.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "agent": "tsx src/agent/agent.ts",
    "generate": "tsx src/agent/agent.ts --generate-only"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
